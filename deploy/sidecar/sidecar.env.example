# ai-control-plane sidecar — environment
#
# Copy to /opt/ai-relay/sidecar.env on the voice host, fill in, chmod 600.
# This file holds every provider credential we own; it is the most sensitive
# file on the machine.

# ---------------------------------------------------------------------------
# Where it listens
# ---------------------------------------------------------------------------

# LOOPBACK ONLY. This is not a preference — with --network host, binding
# 0.0.0.0 publishes an unauthenticated-by-default proxy to paid AI accounts on
# the box's public IP. The voice agent runs on this same machine, so it never needs
# more than 127.0.0.1.
LISTEN_ADDR=127.0.0.1:8080

# Lets a replacement instance bind the same port while this one drains, so the
# port is never unbound during a deploy. Required by deploy.sh.
LISTEN_REUSE_PORT=true

# Per-instance health address, set by deploy.sh (it alternates 8091/8092), NOT
# here. With a shared main port, only this can answer "is THIS instance up?".
# HEALTH_ADDR=127.0.0.1:8091

# How long shutdown waits for live audio sockets before cutting them. Audio
# sockets last as long as the coaching session does.
SHUTDOWN_GRACE=10m

# ---------------------------------------------------------------------------
# Who may use this sidecar  (INBOUND — keys it ACCEPTS)
# ---------------------------------------------------------------------------
# Format: key:tenant[,key:tenant]. the voice agent presents this as AI_RELAY_KEY.
# Generate: openssl rand -hex 32
RELAY_AUTH_KEYS=<generate-me>:voice_agent

# ---------------------------------------------------------------------------
# Where it reports  (OUTBOUND — the key it PRESENTS)
# ---------------------------------------------------------------------------
# A DIFFERENT key from the one above, and it must appear in the CENTRE's
# RELAY_AUTH_KEYS. The centre books every forwarded row against the tenant
# bound to this key, and ignores any tenant in the payload.
RELAY_REPORT_URL=https://ai-control-plane.example.com
RELAY_REPORT_KEY=<generate-me-too>

# Do NOT set DB_URL. A sidecar has no database, and setting both is refused at
# boot rather than silently resolved.

# ---------------------------------------------------------------------------
# Provider credentials — the real ones. The sidecar holds these; the voice agent's own
# copies go unused once AI_RELAY_URL points here.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
INWORLD_API_KEY=
